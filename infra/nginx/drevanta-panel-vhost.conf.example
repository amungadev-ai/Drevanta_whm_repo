# Drevanta vhost — one coherent installation (directive section 8).
# Managed include for /etc/nginx/sites-available/. TLS terminated here
# (certificate issuance per DEC-014 wave); this example listens on 80.
#
# G40-S2 correction: EVERY client path — including /api/v1/ — terminates at
# the SvelteKit adapter-node BFF. The BFF proxies /api/v1/* to the Go panel
# on loopback and is the only component that converts the bearer token into
# the HttpOnly session cookie. Routing /api/v1/ straight to the Go panel
# would bypass the BFF's cookie ceremony and hand raw bearer tokens to the
# page (token isolation broken). The Go panel must remain loopback-only.
server {
	listen 80;
	server_name panel.drevanta.test;   # replaced with the configured access address

	location / {
		proxy_pass http://127.0.0.1:3100;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_read_timeout 30s;
	}
}
